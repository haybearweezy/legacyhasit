rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Profile pictures ──────────────────────────────────────────────────
    // Path: profiles/{uid}/avatar.{ext}
    // Only the owner can write; anyone authenticated can read.

    match /profiles/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024  // 5 MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Memory photos ─────────────────────────────────────────────────────
    // Path: memories/{uid}/{memoryId}/{filename}
    // Only the uploader can write; reads are handled server-side via signed URLs.

    match /memories/{uid}/{memoryId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024  // 20 MB max
                   && (
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType.matches('video/.*')
                   );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
